rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    function isMember(data) {
      return isAuth() && request.auth.uid in data.memberIds;
    }

    // ── users ──────────────────────────────────────────────────────────
    // Aviso: get/list quedan abiertos a cualquier usuario autenticado
    // porque el selector de chats, la query por lastSeen y la busqueda
    // exacta por email los usan de verdad. Es exposicion conocida, no un
    // descuido: el modelo de amigos (nombre de usuario unico, enlaces de
    // invitacion y solicitudes con aceptacion) la reemplaza y es trabajo
    // de producto. Ver docs/production/threat-model.md, "User directory".
    match /users/{userId} {
      allow get:    if isAuth();       // cualquier usuario autenticado puede leer un doc
      allow list:   if isAuth();       // permite queries y snapshots sobre la colección
      allow create: if isOwner(userId); // solo el propio doc: crear el de otro uid usurpa su lugar
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ── trips ──────────────────────────────────────────────────────────
    match /trips/{tripId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;

      match /packingLists/{listId} {
        allow read, write: if isAuth() &&
          get(/databases/$(database)/documents/trips/$(tripId)).data.userId
          == request.auth.uid;

        match /packingItems/{itemId} {
          allow read, write: if isAuth() &&
            get(/databases/$(database)/documents/trips/$(tripId)).data.userId
            == request.auth.uid;
        }
      }
    }

    // ── chats ──────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isMember(resource.data);
      allow create: if isAuth() &&
        request.auth.uid in request.resource.data.memberIds;
      // memberIds se fija al crear el chat: un miembro puede actualizar lo
      // suyo (unreadBy, contadores) pero no sumar uids ni reescribir la
      // lista, que es como se conservaba acceso despues de una expulsión.
      allow update: if isMember(resource.data) &&
        request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isMember(
          get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create: if isAuth() &&
          request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}

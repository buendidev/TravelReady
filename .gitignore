# Dependencias de Node.js
node_modules/

# Variables de entorno y secretos — NUNCA subir
.env
.env.local
.env.production

# Firebase config — generado por FlutterFire CLI, pero REQUERIDO para compilar.
# NO lo ignores: sin firebase_options.dart el proyecto no analiza ni compila en
# un clon limpio, y CI falla aunque en tu maquina pase. La apiKey de Firebase no
# es un secreto (viaja dentro de la app); la proteccion real son las reglas de
# seguridad, App Check y restringir la key en Google Cloud.

# Editor
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
.pub-cache/
.pub/

# Generados por build_runner
*.g.dart
*.freezed.dart
*.gr.dart

# Logs
*.log
npm-debug.log*

# Android
**/android/.gradle
**/android/captures/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
# El wrapper de Gradle SI va versionado: sin gradlew no se puede construir
# Android desde un clon limpio.

